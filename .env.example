# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://ppp:dev-only-not-a-secret@localhost:5432/ppp?schema=public"

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# Public origin of the app. Cookies are marked Secure when this is https://,
# and API writes are refused unless their Origin matches it.
APP_URL="http://localhost:3000"

# Signs the name cookie, the owner cookie and slicer links.
# 32+ random bytes. Generate with: openssl rand -base64 32
APP_SECRET="dev-only-change-me-openssl-rand-base64-32"

# ---------------------------------------------------------------------------
# The printer owner. Seeded by `npm run db:seed`. Everyone else picks their
# name on /hello; the owner pages are unlocked at /owner with ADMIN_PASSWORD.
# ---------------------------------------------------------------------------
ADMIN_NAME="Ruben Haas"
ADMIN_PASSWORD="dev-only-owner-password"
# ADMIN_EMAIL="ruben@example.org"

# ---------------------------------------------------------------------------
# Where model files are written
# ---------------------------------------------------------------------------
# A directory, not a service. `npm run dev` needs no container for this.
MODELS_ROOT="./data/uploads"

# ---------------------------------------------------------------------------
# Importing a model from a link
# ---------------------------------------------------------------------------
# Off unless named. `printables` adds "or paste a Printables link" to the
# request form; the server then calls api.printables.com itself.
# IMPORT_SOURCES="printables"
