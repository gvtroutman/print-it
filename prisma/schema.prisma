// Pretty Please Print — schema
//
// Two groups of models:
//   * Auth      — owned by Better Auth (User/Session/Account/Verification/Passkey).
//                 Shapes are dictated by the library; verify with
//                 `npx @better-auth/cli generate` after changing plugins.
//   * Domain    — Invite/Story/Comment/Notification, from the handoff data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Auth
// ===========================================================================

enum Role {
  client
  admin
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// --- username plugin ---
  ///
  /// The login identifier. Folded to lower case on write, which is what makes
  /// the unique index case-insensitive; `displayUsername` keeps whatever was
  /// typed so the profile can show it back.
  ///
  /// Nullable because an account can exist before it has one: the seeded admin
  /// is a row written straight through Prisma, and picks a username and a
  /// password from the set-password link the seed prints.
  username        String? @unique
  displayUsername String?

  /// Avatar fallback, e.g. "AY". Derived from `name` on create. The default is
  /// a safety net only — `databaseHooks.user.create.before` always sets it.
  initials String @default("??")

  /// Exactly one `admin` exists; enforced by the partial unique index
  /// `user_single_admin`, added in the enforce_single_admin migration.
  role Role @default(client)

  /// Who invited this user. Null for the seeded admin only.
  invitedById  String?
  invitedBy    User?   @relation("Invitations", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers User[]  @relation("Invitations")

  /// What a member may do for themselves. Off for everybody until the printer
  /// owner switches one on from the guest list; "Add device" and "Add member"
  /// then appear in that member's account menu. Both are moot for the owner,
  /// who can always do either from the admin pages.
  canAddDevice Boolean @default(false)
  canAddMember Boolean @default(false)

  // --- admin plugin ---
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions Session[]
  accounts Account[]
  passkeys Passkey[]

  invitesSent   Invite[]       @relation("InviteAuthor")
  auditEvents   AuditEvent[]   @relation("AuditActor")
  stories       Story[]
  comments      Comment[]
  notifications Notification[]

  /// The 'frr' feature-request track — a parallel backlog to the print one.
  featureRequests FeatureRequest[]
  featureComments FeatureComment[]

  /// What they have put in the donation bin.
  donations Donation[]

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- admin plugin ---
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id        String @id @default(cuid())
  accountId String

  /// Dead, and kept on purpose. Better Auth 1.7.0–1.7.2 required this column
  /// and wrote `local:credential` into it; 1.7.3 stopped writing it and went
  /// back to recognising an account by `providerId` and `accountId`, so a
  /// required column here made every insert fail. It is nullable rather than
  /// dropped because the deploy wizard rolls back to the previous image when a
  /// deploy fails its health check, and that image's client still selects it —
  /// drop it once no deployment can roll back past this point.
  issuer     String?
  providerId String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// scrypt digest as `salt:hash`, written by Better Auth. Only
  /// `providerId: "credential"` rows carry one; a passkey has no password.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

/// Better Auth's generic token store. Backs password-reset links and the
/// WebAuthn challenges. `verification.storeIdentifier: "hashed"` in
/// src/lib/auth.ts means `identifier` holds a digest, not the token — a
/// database reader cannot replay a live reset link.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// WebAuthn credential. `publicKey` is a public key — safe at rest — and the
/// private half never leaves the authenticator.
model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

/// Backs `rateLimit: { storage: "database" }` in src/lib/auth.ts. Shape is
/// dictated by Better Auth: `key` unique, `lastRequest` an epoch-millisecond
/// bigint. Rows are disposable — truncating it only resets the counters.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ===========================================================================
// Domain
// ===========================================================================

/// An invitation to join. There is no public sign-up: a `User` row can only
/// come into existence when a matching pending invite exists (enforced in
/// `src/lib/auth.ts` via `user.validateUserInfo`).
model Invite {
  id    String @id @default(cuid())
  /// Where the link was mailed. Null for an invitation handed over by other
  /// means — the member then has no address at all, and the account that
  /// opens carries a placeholder one (see src/lib/contact-email.ts).
  email String?

  /// SHA-256 of the invite token. The raw token exists only inside the
  /// emailed link — a database dump does not let anyone accept an invite.
  tokenHash String @unique

  /// Display name the admin suggested; the invitee can override it on claim.
  name String?
  role Role    @default(client)

  invitedById String
  invitedBy   User   @relation("InviteAuthor", fields: [invitedById], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  /// Last time the link was (re)sent, for throttling resends in the UI.
  sentAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("invite")
}

/// Append-only record of who did what. Closes the A09 gap from SECURITY.md.
///
/// Deliberately denormalised: `actorEmail` and `subject` are copied in at
/// write time so the trail still reads correctly after the user or the story
/// it refers to has been deleted. Nothing in the app ever updates a row here.
model AuditEvent {
  id     String   @id @default(cuid())
  at     DateTime @default(now())
  /// Dotted verb, e.g. "invite.sent", "story.status_changed".
  action String

  actorId    String?
  actor      User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Kept even if the account is later removed.
  actorEmail String?

  /// What was acted on, in human terms: "PI-4", "ayla@office.example".
  subject String?

  ip        String?
  userAgent String?
  /// Anything else worth keeping. Never put a token or a raw file in here.
  detail    Json?

  @@index([at])
  @@index([action, at])
  @@index([actorId])
  @@map("auditEvent")
}

enum StoryStatus {
  Requested
  Accepted
  Printing
  Done
  Delivery
  Declined
}

/// Unused, and kept on purpose. `Story.material` was this enum until materials
/// became owner-managed text. The previous image's client still casts every
/// insert to it, and the deploy wizard rolls back to that image when a deploy
/// fails its health check — with the type gone, nobody could file a request
/// after a rollback. Drop it once no deployment can roll back past this point.
enum Material {
  PLA
  PETG
  TPU
  Resin
}

/// Retired: how much a print mattered, in three steps, before it became a
/// number. Only `Story.legacyPriority` still uses it, for rollbacks.
enum StoryPriority {
  low
  medium
  high
}

enum CatalogColorMode {
  solid
  gradient
  whatever
  funfetti
}

model Story {
  /// Autoincrement so the display ref stays "PI-" + id.
  id     Int         @id @default(autoincrement())
  title  String
  status StoryStatus @default(Requested)

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  quantity  Int      @default(1)
  /// 1 (the turtle: whenever) to 100 (the rabbit: now). Set by the requester
  /// when filing and changeable while the ticket is still on the rail, by them
  /// or by the owner. It orders the owner's queue; it promises nothing about
  /// when the printer is free. Its own column — see the story_priority_score
  /// migration.
  priority  Int      @default(50) @map("priority_score")
  /// Retired: the three-step priority this replaced, kept in step with
  /// `priority` (by thirds) so a rolled-back image still reads it.
  legacyPriority StoryPriority @default(medium) @map("priority")
  /// Snapshots the catalog label at submission time. Catalog entries may be
  /// renamed or disabled later without rewriting an old order.
  material  String   @default("PETG")
  colorName String
  colorHex  String
  /// CSS swatch snapshot. Gradients render here while colorHex remains the
  /// representative solid used by the 3D viewer.
  colorStyle String?
  /// Snapshot of how the swatch behaves. Kept separate from the editable
  /// label so renaming "Whatever's on" cannot change an old ticket.
  colorMode  CatalogColorMode @default(solid)
  /// A spool the owner does not have but can buy, picked from the
  /// filamentcolors.xyz library (src/lib/filament-library.ts). All four null
  /// for a shelf colour. Snapshots, like the colour above: the library can
  /// rename or drop a swatch without rewriting an old ticket.
  swatchId     Int?
  swatchMaker  String?
  swatchType   String?
  swatchBuyUrl String?
  /// Retired: what the requester offered the owner in return ("a beer").
  /// Requests no longer ask, so new tickets store "". Kept so tickets filed
  /// before keep their data and a rolled-back image can still write it.
  tip       String   @default("")
  note      String   @default("")

  /// Free-text print settings the requester optionally notes (layer height,
  /// infill, supports, temps…), shown to the owner on the ticket so specifics
  /// do not become a back-and-forth. FRR-103, option A — a plain string, not a
  /// structured/gated "advanced mode".
  printSettings String @default("")

  flagged    Boolean @default(false)
  flagReason String?

  // --- uploaded asset. Bytes live under MODELS_ROOT, never the web root. ---
  // All four null together for a request filed as words alone — no model yet.
  filename   String?
  fileSize   Int?
  mimeType   String?
  storageKey String?

  /// Where the model came from, when it was imported from a link instead of
  /// uploaded: the model's page on the site it was fetched from. Built by the
  /// server from what that site's API returned, never copied from what the
  /// requester typed — see src/lib/import.ts. Null for an upload.
  sourceUrl String?

  /// Links the requester sent with the order — the product it fits, a video of
  /// the problem. Typed by a person, so http(s) only and re-checked at render;
  /// see src/lib/links.ts.
  links String[] @default([])

  // --- measured from the mesh at upload time, display only ---
  //
  // There is deliberately no `estimate` column. A print time derived from the
  // bounding box is a guess dressed as a measurement, and the handoff's
  // definition of done rules out claiming to know what the printer will do.
  // A real slicer integration would add one back — see src/lib/models.ts.
  dims String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments      Comment[]
  notifications Notification[]
  attachments   StoryAttachment[]

  @@index([uploaderId])
  @@index([status])
  @@map("story")
}

enum AttachmentKind {
  model
  image
  video
}

/// A file sent with an order besides its main model: another part to print, or
/// a photo or video that explains the job. The main model stays on `Story`, so
/// everything that already reads it — the slicer link, the download, a reprint
/// — is unchanged. Bytes live under MODELS_ROOT like the model's.
model StoryAttachment {
  id      String         @id @default(cuid())
  storyId Int
  story   Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  kind    AttachmentKind

  filename   String
  fileSize   Int
  /// Decided on the server from the bytes, never taken from the browser.
  mimeType   String
  storageKey String
  /// Measured for a model where the format allows it; null otherwise.
  dims       String?

  /// The order the requester added them in.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([storyId])
  @@map("storyAttachment")
}

/// A material the printer owner can currently offer. Disabling an entry only
/// removes it from new requests; stories keep their material snapshot.
model CatalogMaterial {
  id        String   @id @default(cuid())
  name      String   @unique
  /// What the material is, in a sentence or two, shown under the upload
  /// form's material picker. Empty means nothing is shown.
  description String @default("")
  /// The owner's own 1–5 marks for the upload form's comparison chart, one
  /// per trait. Null means the built-in filament table's mark stands (see
  /// src/lib/filament-traits.ts), so only the odd case needs touching.
  strength  Int?
  flex      Int?
  heat      Int?
  finish    Int?
  outdoors  Int?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  colors    CatalogColor[]

  @@index([active, sortOrder])
  @@map("catalogMaterial")
}

/// A spool colour belongs to one material: the upload form changes its colour
/// choices as soon as the requester picks a different material.
model CatalogColor {
  id         String          @id @default(cuid())
  materialId String
  material   CatalogMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  name       String
  hex        String
  /// A CSS background used by swatches in the UI: a colour, a gradient, or sprinkles over a colour.
  style      String
  /// `solid`, `gradient`, `whatever` or `funfetti`; never inferred from the display name.
  mode       CatalogColorMode @default(solid)
  active     Boolean         @default(true)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([materialId, name])
  @@index([materialId, active, sortOrder])
  @@map("catalogColor")
}

model Comment {
  id        String   @id @default(cuid())
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([storyId])
  @@map("comment")
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  storyId     Int?
  story       Story?   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  /// A notification points at a print story OR a feature request (or neither,
  /// for a withdrawal). The two id columns are mutually exclusive in practice;
  /// the Activity feed routes to /story or /frr on whichever is set.
  featureId   Int?
  feature     FeatureRequest? @relation(fields: [featureId], references: [id], onDelete: Cascade)
  text        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId, read])
  @@map("notification")
}

// ===========================================================================
// Feature requests — the 'frr' track
//
// A parallel backlog: users file feature requests, the printer owner triages
// them with the same flow, conversation, notifications and audit trail as a
// print. Kept in its own tables rather than folded into Story, which stays
// purely about printed models. The status flow mirrors the print one's shape
// (forward-only, one step, Done leaves the board, Declined terminal from
// Requested) with feature-appropriate names — see FEATURE_FLOW in scope.ts.
// ===========================================================================

enum FeatureStatus {
  Requested
  Accepted
  InProgress
  Shipped
  Done
  Declined
}

enum FeaturePriority {
  low
  medium
  high
}

enum FeatureCategory {
  ui
  api
  bug
  other
}

model FeatureRequest {
  /// Autoincrement so the display ref stays "FRR-" + (100 + id).
  id          Int             @id @default(autoincrement())
  title       String
  description String          @default("")
  status      FeatureStatus   @default(Requested)
  priority    FeaturePriority @default(medium)
  category    FeatureCategory @default(other)

  requesterId String
  requester   User   @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments      FeatureComment[]
  notifications Notification[]

  @@index([requesterId])
  @@index([status])
  @@map("featureRequest")
}

model FeatureComment {
  id        String         @id @default(cuid())
  featureId Int
  feature   FeatureRequest @relation(fields: [featureId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime       @default(now())

  @@index([featureId])
  @@map("featureComment")
}

/// Retired: the owner-managed list of tips a requester could offer. Nothing
/// reads or writes it any more; the table is kept rather than dropped so a
/// rolled-back image still finds it.
model Benefit {
  id        String   @id @default(cuid())
  label     String   @unique
  preferred Boolean  @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("benefit")
}

// ===========================================================================
// Donation bin
//
// The group chipping in for a machine. The money goes through Ko-fi, outside
// the app, and Ko-fi's webhook (/api/kofi) drops each gift in the bin as it
// is paid. A member can also log what they gave, and the owner can confirm it
// by hand, for anything the webhook did not catch. Only received money counts
// toward the goal, so the bar never shows money nobody has seen yet.
// ===========================================================================

/// Something being saved up for. Rows come from migrations, not the app — the
/// first, the H2D Laser, is seeded by the donation_bin migration.
model DonationBin {
  id        String    @id @default(cuid())
  /// What is being bought, as the shop names it.
  title     String
  /// What it costs, in cents.
  goalCents Int
  /// The shop page, so people can see what they are paying towards.
  url       String?
  /// Where the money is actually given — the owner's Ko-fi page.
  payUrl    String?
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  donations Donation[]

  @@map("donationBin")
}

enum DonationStatus {
  /// Logged by the donor; the owner has not matched it on Ko-fi yet.
  Pledged
  /// The owner has it. Counts toward the goal.
  Received
  /// The owner could not find it on Ko-fi, or it was entered wrong.
  Declined
}

model Donation {
  id                String         @id @default(cuid())
  binId             String
  bin               DonationBin    @relation(fields: [binId], references: [id], onDelete: Cascade)
  /// Null for a Ko-fi gift nobody here has claimed yet — somebody who gave
  /// under an email and a name the app does not know.
  donorId           String?
  donor             User?          @relation(fields: [donorId], references: [id], onDelete: Cascade)
  amountCents       Int
  /// The name or message they gave on Ko-fi, so the owner can match it up.
  note              String         @default("")
  status            DonationStatus @default(Pledged)
  createdAt         DateTime       @default(now())
  /// When it was marked received or declined, by the owner or by Ko-fi.
  decidedAt         DateTime?
  /// Set when Ko-fi's webhook reported the payment. Unique, so a retried
  /// delivery cannot count the same gift twice.
  kofiTransactionId String?        @unique

  @@index([binId, status])
  @@index([donorId])
  @@map("donation")
}

// ===========================================================================
// Printers
//
// The machines on the owner's home, each with an hour meter. The owner reads
// the total hours off the printer and logs them, like a car's odometer; the
// newest reading is the one shown, and the older ones show how fast it climbs.
// ===========================================================================

/// A machine the owner runs. Rows come from migrations, not the app: the
/// first, the P1S Combo, is seeded by the printer_hours migration.
model Printer {
  id        String   @id @default(cuid())
  /// What it is, as the shop names it.
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  readings PrinterReading[]

  @@map("printer")
}

/// One look at the hour meter. Readings only go up, and are never edited.
model PrinterReading {
  id        String   @id @default(cuid())
  printerId String
  printer   Printer  @relation(fields: [printerId], references: [id], onDelete: Cascade)
  /// Total hours the printer has run, to a tenth.
  hours     Float
  /// Optional: "new nozzle", "after the big batch".
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([printerId, createdAt])
  @@map("printerReading")
}
