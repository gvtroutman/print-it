# ---------------------------------------------------------------------------
# Container stack configuration.  cp .env.docker.example .env.docker
#
# Everything here is read by docker-compose.prod.yml. Values that must differ
# between a laptop and a real deployment are called out.
# ---------------------------------------------------------------------------

# --- secrets: generate real ones, do not ship these ---
# Signs the name cookie, the owner cookie and slicer links.
# openssl rand -base64 32
APP_SECRET="CHANGE-ME-openssl-rand-base64-32"
# openssl rand -hex 24
DB_PASSWORD="CHANGE-ME"

# --- where the browser reaches the app ---
# Local testing: http://localhost:3000
# Deployed:      https://print.example.org   (https is required, see README)
APP_URL="http://localhost:3000"
APP_PORT=3000

# --- the printer owner ---
# There is no sign-in: everyone else picks their name on /hello. The owner
# pages (the queue, the catalog, the audit trail) are unlocked at /owner with
# ADMIN_PASSWORD. Changing it locks out every browser that had unlocked them.
# Use a long, random one — anybody who can reach the app can try it.
ADMIN_NAME="Your Name"
ADMIN_PASSWORD="CHANGE-ME"
# ADMIN_EMAIL="you@example.org"

# --- reverse proxy ---
# The network your proxy is on, which docker-compose.proxy.yml joins the app
# to. It must already exist:  docker network create npm-proxy
# PPP_PROXY_NETWORK=npm-proxy

# --- Cloudflare Tunnel ---
# The connector token for docker-compose.tunnel.yml, from Zero Trust →
# Networks → Tunnels → your tunnel → "Install and run a connector". Use that
# overlay INSTEAD OF the proxy one: the origin dials out, so there is no port
# to forward, no A record to keep current, and a dynamic WAN address stops
# being able to take the site down.
#
# This token is a credential, not a hostname. Anything holding it can serve
# traffic for every hostname routed to that tunnel, so treat it like a
# password — and rotate it in the dashboard, which invalidates the old one,
# rather than editing it here if it ever leaks.
#
# It is also the condition TRUST_PROXY_HEADERS=cloudflare depends on: with the
# tunnel and no published host port, Cloudflare really is the only way in.
# CF_TUNNEL_TOKEN=""
# CF_TUNNEL_TAG=latest

# --- which header carries the real client address ---
# Only set this when the app is unreachable except through a proxy you control
# (docker-compose.proxy.yml and docker-compose.tunnel.yml both arrange that).
# Otherwise the audit trail records whatever a client chose to send.
#
#   false        trust nothing. The trail records no address. Default, and
#                correct whenever the app can be reached without the proxy.
#   true         left-most X-Forwarded-For. For a proxy that REPLACES the
#                header, such as Nginx Proxy Manager on its own.
#   cloudflare   CF-Connecting-IP. Required behind Cloudflare, which APPENDS
#                to X-Forwarded-For instead of replacing it — so the left-most
#                entry there is client-chosen and must not be believed.
TRUST_PROXY_HEADERS=false

# --- AGPL source offer ---
# The app shows a "Source · AGPL-3.0" link in its footer. If you MODIFY the
# code and serve it to anyone over a network, section 13 of the licence obliges
# you to offer them your source — so point this at your own repository. Leaving
# it on the upstream default while running modified code looks like compliance
# and is not.
# SOURCE_URL="https://github.com/you/ppp"

# --- importing a model from a link ---
# Off by default. Set it and the request form gains "or paste a Printables
# link": the server fetches the chosen file itself, so nobody has to download a
# model only to upload it again. It needs outbound HTTPS to
# api.printables.com and files.printables.com, and it speaks an API Printables
# has not published — see "Importing from a link" in docs/deployment.md before
# switching it on. The only source so far is `printables`; a misspelt name
# stops the app rather than quietly meaning "off".
# IMPORT_SOURCES="printables"

# --- which published image to run ---
# The wizard reads PPP_TAG from this file and refuses to run without it. Pin a
# release (v1.0.0) or a commit SHA; either is also how you roll back.
PPP_REGISTRY="ghcr.io/gvtroutman"
PPP_TAG="latest"

# --- storage ---
# There is nothing to configure. Model files are written to
# $DATA_ROOT/uploads, which the migrator creates and hands to the app's uid at
# boot. The object store that used to live here is gone; if you are upgrading
# from a version that had one, run the migration in docs/deployment.md first.

# --- where the data lives on disk ---
# Local: ./data
# TrueNAS SCALE: a dataset, e.g. /mnt/tank/ppp
DATA_ROOT="./data"
