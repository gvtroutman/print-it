{
  "name": "print-it",
  "version": "0.3.0",
  "private": true,
  "description": "Invite-only 3D print requests for a small office — upload a model, follow it through the print stages.",
  "license": "AGPL-3.0-or-later",
  "author": "Danilo Licitra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danileau/prettypleaseprint.git"
  },
  "homepage": "https://github.com/danileau/prettypleaseprint#readme",
  "bugs": {
    "url": "https://github.com/danileau/prettypleaseprint/issues"
  },
  "type": "module",
  "scripts": {
    "verify:maintenance": "node --import=tsx scripts/verify-maintenance.ts",
    "predev": "npm run vendor:swagger",
    "dev": "node --env-file-if-exists=.env.local node_modules/next/dist/bin/next dev",
    "prebuild": "npm run vendor:swagger",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify:artwork": "tsx scripts/verify-linked-artwork.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "auth:generate": "better-auth generate --config src/lib/auth.ts",
    "verify:auth": "tsx scripts/verify-auth.ts",
    "probe:security": "tsx scripts/security-probe.ts",
    "verify:models": "tsx scripts/verify-models.ts",
    "verify:upload": "tsx scripts/verify-upload.ts",
    "verify:card-flair": "node --import=tsx scripts/verify-card-flair.ts",
    "verify:sticker-preference": "node --import=tsx scripts/verify-sticker-preference.ts",
    "verify:anniversary": "node --import=tsx scripts/verify-member-anniversary.ts",
    "verify:holidays": "node --import=tsx scripts/verify-holidays.ts",
    "verify:badges": "node --conditions=react-server --import=tsx scripts/verify-badges.ts",
    "verify:import": "tsx scripts/verify-import.ts",
    "verify:passkey": "tsx scripts/verify-passkey.ts",
    "verify:remembered-device": "node --conditions=react-server --import=tsx scripts/verify-remembered-device.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:links": "tsx scripts/check-links.ts",
    "hooks:install": "git config core.hooksPath .githooks && echo \"pre-commit hook active\"",
    "shots": "tsx scripts/screenshot.ts",
    "env:container": "tsx scripts/use-container-env.ts",
    "verify:queue": "tsx scripts/verify-queue.ts",
    "verify:bambu": "node --conditions=react-server --import=tsx scripts/verify-bambu.ts",
    "verify:print-score": "node --import=tsx scripts/verify-print-score.ts",
    "verify:pipeline": "node --import=tsx scripts/verify-ticket-pipeline.ts",
    "verify:bambu-helper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-bambu-helper.ps1",
    "verify:bambu-helper-download": "node --import=tsx scripts/verify-bambu-helper-download.ts",
    "verify:order-usage": "node --import=tsx scripts/verify-order-usage.ts",
    "verify:order-safety": "node --import=tsx scripts/verify-order-safety.ts",
    "verify:feature-safety": "node --import=tsx scripts/verify-feature-safety.ts",
    "verify:request-security": "node --import=tsx scripts/verify-request-security.ts",
    "verify:screens": "node --import=tsx scripts/verify-screen-sizes.ts",
    "verify:gltf": "node --import=tsx scripts/verify-gltf.ts",
    "verify:passkey-freshness": "node --import=tsx scripts/verify-passkey-freshness.ts",
    "verify:frr": "tsx scripts/verify-frr.ts",
    "verify:catalog": "tsx scripts/verify-catalog.ts",
    "verify:store-access": "node --conditions=react-server --import=tsx scripts/verify-store-access.ts",
    "verify:colors": "tsx scripts/verify-color-names.ts",
    "verify:filament-filters": "tsx scripts/verify-filament-filters.ts",
    "verify:color-picker": "node scripts/verify-color-picker.mjs",
    "verify:view-switch": "node scripts/verify-view-switch.mjs",
    "verify:filament-photos": "tsx scripts/verify-filament-photos.ts",
    "verify:scanned-swatches": "tsx scripts/verify-scanned-swatches.ts",
    "verify:filament-glow": "tsx scripts/verify-filament-glow.ts",
    "verify:shelf-photos": "node --conditions=react-server --import=tsx scripts/verify-shelf-photos.ts",
    "verify:shelf-colors": "node --conditions=react-server --import=tsx scripts/verify-shelf-colors.ts",
    "verify:library-colors": "node --conditions=react-server --import=tsx scripts/verify-library-colors.ts",
    "verify:brands": "node --conditions=react-server --import=tsx scripts/verify-filament-brands.ts",
    "verify:admin-filaments": "tsx scripts/verify-admin-filaments.ts",
    "verify:phone": "tsx scripts/verify-phone-app.ts",
    "verify:amazon-products": "node --conditions=react-server --import=tsx scripts/verify-amazon-products.ts",
    "verify:filament-packages": "node --conditions=react-server --import=tsx scripts/verify-filament-packages.ts",
    "sync:logos": "tsx scripts/sync-filament-logos.ts",
    "verify:palette": "tsx scripts/verify-palette.ts",
    "sync:colors": "tsx scripts/sync-filament-palette.ts",
    "verify:api": "tsx scripts/verify-api.ts",
    "vendor:swagger": "tsx scripts/vendor-swagger.ts",
    "migrate:storage": "tsx scripts/export-storage.ts",
    "verify:sticker-artwork": "tsx scripts/verify-sticker-artwork.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.7",
    "cheerio": "1.2.0",
    "fflate": "^0.8.3",
    "next": "15.5.28",
    "nodemailer": "10.1.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.29.0",
    "three": "^0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "prisma": "6.19.3",
    "puppeteer-core": "^25.13.0",
    "server-only": "^0.0.1",
    "swagger-ui-dist": "^5.33.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.5",
    "deepmerge-ts": "^8.0.2"
  }
}
